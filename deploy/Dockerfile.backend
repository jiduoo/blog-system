# ============================================
# 博客系统后端 Dockerfile
# 基于 Go 1.22.5 官方镜像
# ============================================

# 构建阶段
FROM golang:1.22.5-alpine AS builder

# 设置工作目录
WORKDIR /app

# 复制依赖文件
COPY ../Backend/go.mod ../Backend/go.sum ./

# 下载依赖
RUN go mod download

# 复制源代码
COPY ../Backend/ .

# 编译应用（静态编译，不依赖系统库）
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o blog-backend .

# ============================================
# 运行阶段
# ============================================
FROM alpine:latest

# 设置工作目录
WORKDIR /app

# 复制编译好的二进制文件
COPY --from=builder /app/blog-backend .

# 复制配置文件
COPY ../Backend/config ./config

# 创建日志目录
RUN mkdir -p logs

# 设置环境变量
ENV GIN_MODE=release

# 暴露端口
EXPOSE 3000

# 启动命令
CMD ["./blog-backend"]